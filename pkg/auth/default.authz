# The built-in policy, used when no policy file is configured. It declares the
# three roles and grants nothing: groups are mapped to roles by configuration,
# and a person in no mapped group holds no role.
#
# A test in policy_test.go holds these roles to the permissions they had
# before the policy language, so changing this file changes who may do what.

# Reads everything in the tenant and changes nothing.
role viewer { allow read on * }

# Runs agents, manages schedules, acknowledges alerts and sets their rules,
# runs evals and deletes published files.
role operator extends viewer {
  allow write on runs, schedules, alerts, evals, artifacts
}

# Also defines and revises agents, decides what they are grounded in, sets
# limits and manages the workspace's clients.
role admin { allow * on * }
